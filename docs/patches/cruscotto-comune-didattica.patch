+import type { Metadata } from "next";
+import { notFound } from "next/navigation";
+import { DemoComuneForm } from "@/components/DemoComuneForm";
+import { DemoDidatticaBanners } from "@/components/DidatticaBanner";
+import { DemoKpiGrid } from "@/components/DemoKpiGrid";
+import { DidatticaProvider } from "@/components/DidatticaProvider";
+import { Footer } from "@/components/Footer";
+import { Header } from "@/components/Header";
+import { getCachedKpiFor } from "@/lib/dashboard";
+import {
+  DEMO_COMUNI,
+  demoComuneByIstat,
+} from "@/lib/demo-comuni";
+
+export const revalidate = 86400;
+export const dynamicParams = false;
+
+export function generateStaticParams() {
+  return DEMO_COMUNI.map((c) => ({ istat: c.istat }));
+}
+
+export async function generateMetadata({
+  params,
+}: {
+  params: Promise<{ istat: string }>;
+}): Promise<Metadata> {
+  const { istat } = await params;
+  const comune = demoComuneByIstat(istat);
+  const title = comune
+    ? `Anteprima didattica — ${comune.nome}`
+    : "Anteprima didattica";
+  return {
+    title,
+    description:
+      "Sandbox didattica sul nucleo nazionale di KPI AgID. Non è un cruscotto ufficiale del comune.",
+    robots: { index: false, follow: false },
+    alternates: { canonical: `/demo/${istat}` },
+  };
+}
+
+export default async function Page({
+  params,
+  searchParams,
+}: {
+  params: Promise<{ istat: string }>;
+  searchParams: Promise<{ didattica?: string }>;
+}) {
+  const { istat } = await params;
+  const comune = demoComuneByIstat(istat);
+  if (!comune) notFound();
+  const didattica = (await searchParams).didattica === "1";
+
+  let kpi: Record<string, unknown> = {};
+  let error: string | null = null;
+  try {
+    kpi = await getCachedKpiFor(istat);
+  } catch (err) {
+    console.error(err);
+    error =
+      "Non è stato possibile recuperare i KPI da Cruscotto Italia. Riprova più tardi.";
+  }
+
+  return (
+    <div className="flex min-h-screen flex-col bg-[var(--background)]">
+      <DemoDidatticaBanners
+        didattica={didattica}
+        cleanPath={`/demo/${istat}`}
+      />
+      <Header brandAsHeading={false} />
+      <main
+        id="contenuto-principale"
+        className="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6"
+      >
+        <h1 className="mb-2 text-2xl font-bold text-[var(--pa-ink)] sm:text-3xl">
+          Anteprima didattica — {comune.nome}
+        </h1>
+        <p className="max-w-prose text-sm text-[var(--pa-muted)]">
+          {comune.regione} ({comune.provincia}), codice ISTAT {comune.istat}.
+          Solo nucleo nazionale. Porto, balneazione, treni, GTFS locale,
+          erosione costiera, acqua SII, eventi comunali e allerte SIR restano
+          spenti. Progetto indipendente, non ufficiale: non affiliato ad AgID,
+          al Governo o al Comune di {comune.nome}.
+        </p>
+        <div className="mt-6 mb-8">
+          <DemoComuneForm currentIstat={istat} didattica={didattica} />
+        </div>
+        {error ? (
+          <p className="rounded-lg border border-[#d9364f] bg-[#fce8eb] p-4">
+            {error}
+          </p>
+        ) : (
+          <DidatticaProvider active={didattica}>
+            <DemoKpiGrid kpi={kpi} />
+          </DidatticaProvider>
+        )}
+      </main>
+      <Footer />
+    </div>
+  );
+}
