+alias("Raccolta differenziata", "Separate waste collection", ISPRA);
+alias("Consumo di suolo", "Land consumption", {
+  ...AGID,
+  misura: "Consumo di suolo; la fonte primaria è ambientale (ISPRA / territorio AgID). Verificare periodo e definizione sulla scheda.",
+});
+alias("Copertura FTTH", "FTTH coverage", {
+  ...AGID,
+  misura: "Copertura banda ultra-larga FTTH (AGCOM via Cruscotto Italia).",
+});
+alias("Farmacie", "Pharmacies", FARMACIE);
+alias("Punti ricarica EV", "EV charging points", EV);
+alias("Impianti carburanti", "Fuel stations", EV);
+alias("Accessibilità OSM", "OSM accessibility", OSM);
+alias("Enti RUNTS", "RUNTS entities", {
+  ...AGID,
+  misura: "Enti del Terzo settore iscritti al RUNTS nel comune.",
+});
+alias("Unità locali ASIA", "ASIA local units", {
+  ...AGID,
+  misura: "Unità locali delle imprese (ASIA).",
+});
+alias("Saldo cassa SIOPE", "SIOPE cash balance", {
+  ...AGID,
+  misura: "Saldo di cassa del comune (SIOPE).",
+});
+alias("PNRR", "NRRP", {
+  ...AGID,
+  misura: "Progetti PNRR sul comune.",
+});
+alias("Opere BDAP", "BDAP public works", {
+  ...AGID,
+  misura: "Opere pubbliche (BDAP).",
+});
+alias("Contratti ANAC", "ANAC contracts", {
+  ...AGID,
+  misura: "Contratti pubblici (ANAC).",
+});
+alias("Patrimonio PA", "PA real estate", {
+  ...AGID,
+  misura: "Patrimonio immobiliare della PA nel comune.",
+});
+alias("Civici ANNCSU", "ANNCSU street numbers", {
+  ...AGID,
+  misura: "Civici dell'archivio nazionale (ANNCSU).",
+});
+alias("Pendolarismo netto", "Net commuting", {
+  ...AGID,
+  misura: "Saldo dei flussi di pendolarismo.",
+});
+alias("Elevazione media", "Mean elevation", {
+  ...AGID,
+  misura: "Elevazione media del territorio comunale.",
+});
+alias("Veicoli", "Vehicles", {
+  ...AGID,
+  misura: "Parco veicolare (ACI via Cruscotto Italia).",
+});
+alias("Terziario", "Tertiary sector", {
+  ...AGID,
+  misura: "Quota o addetti del terziario.",
+});
+alias("Alunni", "Pupils", MIUR);
+alias("Temperatura", "Temperature", METEO);
+alias("Allerta meteo", "Weather alert", ALLERTE);
+alias("Quotazione OMI", "OMI listing", OMI);
+alias("Defibrillatori", "Defibrillators", DAE);
+alias("IRPEF", "Personal income tax", DVNS);
+
+export function kpiMetadatoForLabel(label: string): KpiMetadato | undefined {
+  return BY_LABEL[label];
+}
+
+/**
+ * Etichette che compaiono in dashboard e non hanno una voce in questa mappa.
+ * Non inventare metadati per queste: restano senza blocco didattico.
