+import type { Metadata } from "next";
+import { redirect } from "next/navigation";
+import { DemoComuneForm } from "@/components/DemoComuneForm";
+import { DemoDidatticaBanners } from "@/components/DidatticaBanner";
+import { Footer } from "@/components/Footer";
+import { Header } from "@/components/Header";
+import {
+  DEMO_COMUNI,
+  isDemoIstat,
+} from "@/lib/demo-comuni";
+
+export const revalidate = 86400;
+
+export const metadata: Metadata = {
+  title: "Anteprima didattica",
+  description:
+    "Sandbox didattica: nucleo nazionale di KPI AgID per una lista chiusa di comuni. Non è un cruscotto ufficiale.",
+  robots: { index: false, follow: false },
+  alternates: { canonical: "/demo" },
+};
+
+export default async function Page({
+  searchParams,
+}: {
+  searchParams: Promise<{ istat?: string; didattica?: string }>;
+}) {
+  const sp = await searchParams;
+  const istat = sp.istat?.trim() ?? "";
+  const didattica = sp.didattica === "1";
+  if (istat && isDemoIstat(istat)) {
+    redirect(`/demo/${istat}${didattica ? "?didattica=1" : ""}`);
+  }
+
+  return (
+    <div className="flex min-h-screen flex-col bg-[var(--background)]">
+      <DemoDidatticaBanners didattica={didattica} cleanPath="/demo" />
+      <Header brandAsHeading={false} />
+      <main id="contenuto-principale" className="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6">
+        <h1 className="mb-3 text-2xl font-bold text-[var(--pa-ink)] sm:text-3xl">
+          Anteprima didattica
+        </h1>
+        <p className="max-w-prose text-[var(--pa-muted)]">
+          Lista chiusa di comuni, uno per regione. Solo il nucleo nazionale
+          (KPI AgID per codice ISTAT). I moduli opzionali restano spenti.
+          Cache 24 ore: una classe sulla stessa pagina non genera una chiamata
+          a studente. Scegli un comune e apri l&apos;anteprima. Zero JavaScript
+          sul selettore: è un form GET.
+        </p>
+        <div className="mt-6">
+          <DemoComuneForm didattica={didattica} />
+        </div>
+        <ul className="mt-8 columns-1 gap-2 sm:columns-2">
+          {DEMO_COMUNI.map((c) => (
+            <li key={c.istat} className="mb-1 break-inside-avoid">
+              <a href={`/demo/${c.istat}${didattica ? "?didattica=1" : ""}`}>
+                {c.nome} — {c.regione} ({c.istat})
+              </a>
+            </li>
+          ))}
+        </ul>
+      </main>
+      <Footer />
+    </div>
+  );
+}
