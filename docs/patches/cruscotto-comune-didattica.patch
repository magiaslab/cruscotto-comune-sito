+/**
+ * Metadati KPI per la modalità didattica (`?didattica=1`).
+ * Derivati da `src/lib/fonti.ts`. Non inventare cadenza o licenza.
+ */
+
+import { FONTI, type FonteVoce } from "@/lib/fonti";
+
+export type KpiMetadato = {
+  misura: string;
+  ente: string;
+  frequenza: string;
+  licenza: string;
+  fonteNome: string;
+  url: string;
+};
+
+function fromFonte(
+  nome: string,
+  misura: string,
+  frequenza: string,
+): KpiMetadato {
+  const fonte: FonteVoce | undefined = FONTI.find((f) => f.nome === nome);
+  if (!fonte) {
+    throw new Error(`Fonte non trovata nel catalogo: ${nome}`);
+  }
+  return {
+    misura,
+    ente: fonte.ente,
+    frequenza,
+    licenza: fonte.licenza,
+    fonteNome: fonte.nome,
+    url: fonte.url,
+  };
+}
+
+const AGID = fromFonte(
+  "Cruscotto Italia (MCP)",
+  "Indicatore comunale filtrato per codice ISTAT, dal nucleo nazionale AgID.",
+  "Eredita la cadenza della fonte primaria. In classe si legge la data sul dato, non si assume.",
+);
+
+const OSM = fromFonte(
+  "OpenStreetMap / Overpass / CARTO",
+  "Oggetti geografici sul territorio (mappe, servizi, accessibilità).",
+  "Continuo, a cura dei volontari. La data sta nei metadati OSM.",
+);
+
+const METEO = fromFonte(
+  "Open-Meteo + RainViewer + ItaliaMeteo",
+  "Meteo live e previsioni.",
+  "Live / previsioni. Non è una serie storica di lungo periodo.",
+);
+
+const ALLERTE = fromFonte(
+  "Allerte Protezione Civile",
+  "Allerte meteo-idrogeologiche per il comune.",
+  "Bollettini quando c'è un'allerta. Non è una serie storica.",
+);
+
+const ISPRA = fromFonte(
+  "Catasto rifiuti ISPRA",
+  "Rifiuti urbani e raccolta differenziata, filtro ISTAT.",
+  "CSV nazionale; la cadenza si legge sul dataset. Non assumere l'anno.",
+);
+
+const OMI = fromFonte(
+  "OMI — quotazioni immobiliari",
+  "Quotazioni immobiliari OMI per zona.",
+  "Snapshot locale. La data sta nel file.",
+);
+
+const MIUR = fromFonte(
+  "Scuole MIUR",
+  "Anagrafe delle scuole del comune (serve il codice catastale).",
+  "Open data MIM. La data si legge sul dataset.",
+);
+
+const FARMACIE = fromFonte(
+  "Farmacie di turno",
+  "Farmacie e turni del giorno.",
+  "Turni del giorno sul sito pubblico.",
+);
+
+const DAE = fromFonte(
+  "DAE / OpenAEDMap",
+  "Defibrillatori georeferenziati.",
+  "Export da OpenStreetMap. Data dell'export sul file.",
+);
+
+const EV = fromFonte(
+  "Colonnine EV e carburanti",
+  "Punti di ricarica e/o impianti carburanti.",
+  "Indicativo. Verificare la data sulla fonte, non sul cruscotto.",
+);
+
+const DVNS = fromFonte(
+  "DoveVannoINostriSoldi (IRPEF / OpenCivitas)",
+  "Indicatori di finanza / IRPEF a scala comunale.",
+  "Periodo fiscale sulla fonte. Non sostituisce il SIOPE AgID.",
+);
+
+/** Etichetta italiana → metadato. Alias inglese per quando la UI è in en. */
+const BY_LABEL: Record<string, KpiMetadato> = {};
+
+function alias(it: string, en: string, meta: KpiMetadato) {
+  BY_LABEL[it] = meta;
+  BY_LABEL[en] = meta;
+}
+
+alias("Popolazione", "Population", {
+  ...AGID,
+  misura: "Residenti nel comune.",
+});
+alias("Età media", "Average age", {
+  ...AGID,
+  misura: "Età media della popolazione residente.",
+});
+alias("Indice di vecchiaia", "Old-age index", {
