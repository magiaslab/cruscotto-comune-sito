+import Link from "next/link";
+import { DEMO_RIUSA_URL, DEMO_SCUOLA_URL } from "@/lib/demo-comuni";
+
+export function DemoDidatticaBanners({
+  didattica,
+  cleanPath,
+}: {
+  didattica: boolean;
+  cleanPath: string;
+}) {
+  return (
+    <div className="space-y-0">
+      <p className="m-0 bg-[var(--pa-ink)] px-4 py-2 text-center text-sm text-white">
+        Anteprima didattica. Per avere il cruscotto del tuo comune serve il fork
+        —{" "}
+        <a
+          href={DEMO_RIUSA_URL}
+          className="font-semibold text-white underline"
+          rel="noopener noreferrer"
+        >
+          guida al riuso
+        </a>
+        . Percorso per le classi:{" "}
+        <a
+          href={DEMO_SCUOLA_URL}
+          className="font-semibold text-white underline"
+          rel="noopener noreferrer"
+        >
+          /scuola
+        </a>
+        .
+      </p>
+      {didattica ? (
+        <p className="m-0 border-b border-[var(--pa-border)] bg-[var(--pa-surface-soft)] px-4 py-2 text-center text-sm text-[var(--pa-ink)]">
+          Modalità didattica attiva. Sotto ogni KPI, se il metadato esiste in
+          catalogo: che cosa misura, chi lo produce, frequenza, licenza.{" "}
+          <Link href={cleanPath} className="font-semibold">
+            URL pulito (esci dalla modalità)
+          </Link>
+          .
+        </p>
+      ) : (
+        <p className="m-0 border-b border-[var(--pa-border)] bg-white px-4 py-2 text-center text-sm text-[var(--pa-muted)]">
+          <Link href={`${cleanPath}?didattica=1`} className="font-semibold">
+            Attiva la modalità didattica
+          </Link>{" "}
+          per leggere fonte e licenza sotto i numeri.
+        </p>
+      )}
+    </div>
+  );
+}
+
+export function DidatticaHomeBanner({ didattica }: { didattica: boolean }) {
+  if (!didattica) return null;
+  return (
+    <p className="m-0 border-b border-[var(--pa-border)] bg-[var(--pa-surface-soft)] px-4 py-2 text-center text-sm text-[var(--pa-ink)]">
+      Modalità didattica attiva.{" "}
+      <Link href="/" className="font-semibold">
+        Torna all&apos;URL pulito
+      </Link>
+      .
+    </p>
+  );
+}
