+import demoJson from "@/data/demo-comuni.json";
+
+export type DemoComune = {
+  istat: string;
+  nome: string;
+  regione: string;
+  provincia: string;
+  lat: number;
+  lon: number;
+};
+
+export const DEMO_COMUNI: DemoComune[] = demoJson as DemoComune[];
+
+const BY_ISTAT = new Map(DEMO_COMUNI.map((c) => [c.istat, c]));
+
+export function demoComuneByIstat(istat: string): DemoComune | undefined {
+  return BY_ISTAT.get(istat);
+}
+
+export function isDemoIstat(istat: string): boolean {
+  return BY_ISTAT.has(istat);
+}
+
+export const DEMO_RIUSA_URL = "https://www.cruscottocomune.it/riusa";
+export const DEMO_SCUOLA_URL = "https://www.cruscottocomune.it/scuola";
