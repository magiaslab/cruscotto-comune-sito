@@ -0,0 +1,76 @@
+import { KpiCard, valueOrMissing } from "@/components/ui";
+import { formatDecimal, formatEuro, formatInteger } from "@/lib/format";
+
+function asRecord(v: unknown): Record<string, unknown> | null {
+  return v && typeof v === "object" && !Array.isArray(v)
+    ? (v as Record<string, unknown>)
+    : null;
+}
+
+function num(v: unknown): number | null {
+  return typeof v === "number" && !Number.isNaN(v) ? v : null;
+}
+
+export function DemoKpiGrid({ kpi }: { kpi: Record<string, unknown> }) {
+  const demo = asRecord(kpi.demografia);
+  const turismo = asRecord(kpi.turismo);
+  const redditi = asRecord(kpi.redditi_mef);
+  const ambiente = asRecord(kpi.ambiente);
+  const banda = asRecord(kpi.banda_larga_agcom);
+  const pnrr = asRecord(kpi.pnrr);
+  const siope = asRecord(kpi.siope);
+  const imprese = asRecord(kpi.imprese_asia);
+
+  const cards: { label: string; value: string; hint?: string }[] = [
+    {
+      label: "Popolazione",
+      value: valueOrMissing(demo?.popolazione, formatInteger),
+      hint: String(demo?.riferimento ?? ""),
+    },
+    {
+      label: "Reddito medio",
+      value: valueOrMissing(redditi?.reddito_medio_eur, formatEuro),
+      hint: redditi?.n_contribuenti
+        ? `${formatInteger(num(redditi.n_contribuenti))} contribuenti`
+        : undefined,
+    },
+    {
+      label: "Indice turisticità",
+      value: valueOrMissing(turismo?.indice_turisticita_per_100ab, (v) =>
+        `${formatDecimal(v, 1)} /100 ab.`,
+      ),
+    },
+    {
+      label: "Raccolta differenziata",
+      value: valueOrMissing(ambiente?.raccolta_differenziata_pct, (v) =>
+        `${formatDecimal(v, 1)}%`,
+      ),
+    },
+    {
+      label: "Copertura FTTH",
+      value: valueOrMissing(banda?.copertura_ftth_pct, (v) =>
+        `${formatDecimal(v, 1)}%`,
+      ),
+    },
+    {
+      label: "Unità locali ASIA",
+      value: valueOrMissing(imprese?.unita_locali, formatInteger),
+    },
+    {
+      label: "Saldo cassa SIOPE",
+      value: valueOrMissing(siope?.saldo_cassa, formatEuro),
+    },
+    {
+      label: "PNRR",
+      value: valueOrMissing(pnrr?.n_progetti, formatInteger),
+    },
+  ];
+
+  return (
+    <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
+      {cards.map((c) => (
+        <KpiCard key={c.label} label={c.label} value={c.value} hint={c.hint} />
+      ))}
+    </div>
+  );
+}
