+"use client";
+
+import { createContext, useContext, type ReactNode } from "react";
+
+const DidatticaContext = createContext(false);
+
+export function DidatticaProvider({
+  active,
+  children,
+}: {
+  active: boolean;
+  children: ReactNode;
+}) {
+  return (
+    <DidatticaContext.Provider value={active}>{children}</DidatticaContext.Provider>
+  );
+}
+
+export function useDidattica() {
+  return useContext(DidatticaContext);
+}
